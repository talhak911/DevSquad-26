<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/globals.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <a href="/" class="brand">TaskManager</a>
      <div class="nav-actions">
        <span id="user-display" style="font-weight: 500"></span>
        <button
          class="btn btn-icon theme-btn"
          id="theme-toggle"
          aria-label="Toggle theme"
        >
          <svg
            class="sun-icon"
            width="56"
            height="32"
            viewBox="0 0 56 32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect width="56" height="32" rx="16" fill="#051724" />
            <path
              d="M14.0001 21.8334C17.2217 21.8334 19.8334 19.2217 19.8334 16.0001C19.8334 12.7784 17.2217 10.1667 14.0001 10.1667C10.7784 10.1667 8.16675 12.7784 8.16675 16.0001C8.16675 19.2217 10.7784 21.8334 14.0001 21.8334Z"
              fill="#FFF194"
            />
            <path
              d="M13.9999 25.1333C13.5416 25.1333 13.1666 24.7916 13.1666 24.3333V24.2666C13.1666 23.8083 13.5416 23.4333 13.9999 23.4333C14.4583 23.4333 14.8333 23.8083 14.8333 24.2666C14.8333 24.7249 14.4583 25.1333 13.9999 25.1333ZM19.9499 22.7833C19.7333 22.7833 19.5249 22.6999 19.3583 22.5416L19.2499 22.4333C18.9249 22.1083 18.9249 21.5833 19.2499 21.2583C19.5749 20.9333 20.0999 20.9333 20.4249 21.2583L20.5333 21.3666C20.8583 21.6916 20.8583 22.2166 20.5333 22.5416C20.3749 22.6999 20.1666 22.7833 19.9499 22.7833ZM8.04992 22.7833C7.83325 22.7833 7.62492 22.6999 7.45825 22.5416C7.13325 22.2166 7.13325 21.6916 7.45825 21.3666L7.56659 21.2583C7.89159 20.9333 8.41659 20.9333 8.74159 21.2583C9.06659 21.5833 9.06659 22.1083 8.74159 22.4333L8.63325 22.5416C8.47492 22.6999 8.25825 22.7833 8.04992 22.7833ZM22.3333 16.8333H22.2666C21.8083 16.8333 21.4333 16.4583 21.4333 15.9999C21.4333 15.5416 21.8083 15.1666 22.2666 15.1666C22.7249 15.1666 23.1333 15.5416 23.1333 15.9999C23.1333 16.4583 22.7916 16.8333 22.3333 16.8333ZM5.73325 16.8333H5.66659C5.20825 16.8333 4.83325 16.4583 4.83325 15.9999C4.83325 15.5416 5.20825 15.1666 5.66659 15.1666C6.12492 15.1666 6.53325 15.5416 6.53325 15.9999C6.53325 16.4583 6.19159 16.8333 5.73325 16.8333ZM19.8416 10.9916C19.6249 10.9916 19.4166 10.9083 19.2499 10.7499C18.9249 10.4249 18.9249 9.89992 19.2499 9.57492L19.3583 9.46659C19.6833 9.14159 20.2083 9.14159 20.5333 9.46659C20.8583 9.79158 20.8583 10.3166 20.5333 10.6416L20.4249 10.7499C20.2666 10.9083 20.0583 10.9916 19.8416 10.9916ZM8.15825 10.9916C7.94159 10.9916 7.73325 10.9083 7.56659 10.7499L7.45825 10.6333C7.13325 10.3083 7.13325 9.78325 7.45825 9.45825C7.78325 9.13325 8.30825 9.13325 8.63325 9.45825L8.74159 9.56659C9.06659 9.89159 9.06659 10.4166 8.74159 10.7416C8.58325 10.9083 8.36659 10.9916 8.15825 10.9916ZM13.9999 8.53325C13.5416 8.53325 13.1666 8.19159 13.1666 7.73325V7.66659C13.1666 7.20825 13.5416 6.83325 13.9999 6.83325C14.4583 6.83325 14.8333 7.20825 14.8333 7.66659C14.8333 8.12492 14.4583 8.53325 13.9999 8.53325Z"
              fill="#FFF194"
            />
            <rect
              class="toggle-circle"
              x="28"
              y="4"
              width="24"
              height="24"
              rx="12"
              fill="white"
            />
          </svg>
        </button>
        <button class="btn btn-outline" id="logout-btn">Logout</button>
      </div>
    </header>

    <main class="dashboard-container">
      <div class="dashboard-header">
        <h2>My Tasks</h2>
        <div
          id="task-stats"
          style="font-size: 0.9rem; color: var(--placeholder-color)"
        >
          <!-- Stats loaded via JS -->
        </div>
      </div>

      <form class="add-task-form" id="add-task-form">
        <input
          type="text"
          id="task-title"
          placeholder="What needs to be done?"
          required
        />
        <button type="submit" class="btn btn-primary" id="add-task-btn">
          Add Task
        </button>
      </form>

      <div class="task-list" id="task-list">
        <!-- Tasks rendered via JS -->
        <p style="text-align: center; color: var(--placeholder-color)">
          Loading tasks...
        </p>
      </div>
    </main>

    <div id="toast" class="toast"></div>

    <script>
      // Theme logic
      const themeToggle = document.getElementById("theme-toggle");
      const storedTheme = localStorage.getItem("theme");
      if (storedTheme) {
        document.documentElement.setAttribute("data-theme", storedTheme);
      } else {
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (prefersDark) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      }

      themeToggle.addEventListener("click", () => {
        const currentTheme =
          document.documentElement.getAttribute("data-theme");
        const newTheme = currentTheme === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", newTheme);
        localStorage.setItem("theme", newTheme);
      });

      // Auth verification
      const token = localStorage.getItem("token");
      if (!token) {
        window.location.href = "/login";
      }

      // Logout
      document
        .getElementById("logout-btn")
        .addEventListener("click", async () => {
          try {
            await fetch("/api/users/logout", { method: "POST" });
          } catch (e) {
            console.error("Logout API failed", e);
          }
          localStorage.removeItem("token");
          window.location.href = "/login";
        });

      // Toast
      function showToast(message, type = "success") {
        const toast = document.getElementById("toast");
        toast.textContent = message;
        toast.className = `toast show ${type}`;
        setTimeout(() => {
          toast.className = "toast";
        }, 3000);
      }

      // Load Data
      const taskList = document.getElementById("task-list");
      const taskStats = document.getElementById("task-stats");

      // API Fetch Wrapper with Interceptor
      async function apiFetch(url, options = {}) {
        let token = localStorage.getItem("token");

        // Define standard headers
        const headers = {
          "Content-Type": "application/json",
          ...options.headers,
        };

        if (token) {
          headers["Authorization"] = `Bearer ${token}`;
        }

        let response = await fetch(url, { ...options, headers });

        // If unauthorized, attempt to refresh
        if (response.status === 401 && token) {
          try {
            const refreshRes = await fetch("/api/users/refresh", {
              method: "POST",
            });
            const refreshData = await refreshRes.json();

            if (refreshRes.ok && refreshData.success) {
              const newToken = refreshData.data.token;
              localStorage.setItem("token", newToken);

              // Retry original request with new token
              headers["Authorization"] = `Bearer ${newToken}`;
              response = await fetch(url, { ...options, headers });
            } else {
              // Refresh token is invalid/expired
              localStorage.removeItem("token");
              window.location.href = "/login";
            }
          } catch (err) {
            localStorage.removeItem("token");
            window.location.href = "/login";
          }
        }
        return response;
      }

      async function loadUser() {
        try {
          const res = await apiFetch("/api/users/me");
          const data = await res.json();
          if (res.ok) {
            document.getElementById("user-display").textContent =
              `Hello, ${data.data.user.name.split(" ")[0]}`;
          }
        } catch (err) {
          console.error(err);
        }
      }

      async function loadStats() {
        try {
          const res = await apiFetch("/api/tasks/stats");
          const data = await res.json();
          if (res.ok) {
            taskStats.innerHTML = `${data.data.completed} concluded &nbsp;&bull;&nbsp; ${data.data.pending} pending`;
          }
        } catch (err) {
          console.error(err);
        }
      }

      async function loadTasks() {
        try {
          const res = await apiFetch("/api/tasks");
          const data = await res.json();

          if (res.ok) {
            taskList.innerHTML = "";
            const tasks = data.data.tasks;

            if (tasks.length === 0) {
              taskList.innerHTML = `<p style="text-align: center; color: var(--placeholder-color);">You don't have any tasks currently</p>`;
            }

            tasks.forEach((task) => {
              const taskEl = document.createElement("div");
              taskEl.className = `task-item ${task.completed ? "completed" : ""}`;
              taskEl.innerHTML = `
              <div class="task-content">
                <input type="checkbox" class="task-checkbox" ${task.completed ? "checked" : ""} onchange="toggleTask('${task._id}', ${!task.completed})">
                <span class="task-title">${escapeHTML(task.title)}</span>
              </div>
              <div class="task-actions">
                <button class="btn btn-icon" style="color: var(--danger-color)" onclick="deleteTask('${task._id}')" aria-label="Delete">🗑️</button>
              </div>
            `;
              taskList.appendChild(taskEl);
            });
          }
        } catch (err) {
          console.error(err);
        }
      }

      // Add Task
      document
        .getElementById("add-task-form")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const titleInput = document.getElementById("task-title");
          const title = titleInput.value.trim();
          const addBtn = document.getElementById("add-task-btn");

          if (!title) return;

          addBtn.disabled = true;

          try {
            const res = await apiFetch("/api/tasks", {
              method: "POST",
              body: JSON.stringify({ title, completed: false }),
            });

            if (res.ok) {
              titleInput.value = "";
              loadTasks();
              loadStats();
              showToast("Task added");
            } else {
              showToast("Failed to add task", "error");
            }
          } catch (err) {
            showToast("Error occurred", "error");
          } finally {
            addBtn.disabled = false;
          }
        });

      // Toggle Task
      window.toggleTask = async (id, isComplete) => {
        try {
          await apiFetch(`/api/tasks/${id}`, {
            method: "PUT",
            body: JSON.stringify({ completed: isComplete }),
          });
          loadTasks();
          loadStats();
        } catch (err) {
          showToast("Warning: Checkbox failed to sync", "error");
        }
      };

      // Delete Task
      window.deleteTask = async (id) => {
        if (!confirm("Are you sure you want to delete this task?")) return;
        try {
          await apiFetch(`/api/tasks/${id}`, {
            method: "DELETE",
          });
          loadTasks();
          loadStats();
          showToast("Task deleted");
        } catch (err) {
          showToast("Failed to delete", "error");
        }
      };

      function escapeHTML(str) {
        const div = document.createElement("div");
        div.innerText = str;
        return div.innerHTML;
      }

      // Initial Load
      loadUser();
      loadStats();
      loadTasks();
    </script>
  </body>
</html>
