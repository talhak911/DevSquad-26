{
  "info": {
    "name": "Task Manager API",
    "description": "API requests to manage an in-memory task manager using Node and Express.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tasks",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tasks"]
        }
      },
      "response": []
    },
    {
      "name": "Get Tasks by Title (Search)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tasks?title=learn",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tasks"],
          "query": [
            {
              "key": "title",
              "value": "learn"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Task By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tasks/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tasks", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "your-uuid-here"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Add a new Task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Learn Express\",\n    \"completed\": false\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/tasks",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tasks"]
        }
      },
      "response": []
    },
    {
      "name": "Update a Task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Master Express\",\n    \"completed\": true\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/tasks/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tasks", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "your-uuid-here"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Remove a Task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tasks/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tasks", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "your-uuid-here"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Task Stats",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/stats",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "stats"]
        }
      },
      "response": []
    }
  ]
}
